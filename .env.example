DATABASE_URL=postgresql+asyncpg://agent_office:agent_office@localhost:5433/agent_office
# The port uvicorn binds. The frontend follows it: Makefile derives VITE_API_BASE_URL
# from this unless you set that yourself.
AGENT_OFFICE_API_PORT=8000
MAX_CONCURRENT_AGENTS=3
# The only directory the repository picker may browse. Defaults to $HOME.
AGENT_OFFICE_BROWSE_ROOT=
AGENT_OFFICE_CORS_ORIGINS=http://localhost:5173
